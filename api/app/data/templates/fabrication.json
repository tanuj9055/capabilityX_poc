    "key_machinery"
   ],
   "req": "Fabrication bay, cranes and welding equipment for {v}-tonne structures",
   "kind": "mandatory",
   "unit": "tonnes"
  },
  {
   "id": "welding_std",
   "label": "Welding standard",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "IS 816",
    "AWS D1.1",
    "ISO 3834",
    "EN 15085 (rail)"
   ],
   "ask": true,
   "question": "Welding standard?",
   "data_point_ids": [
    "sector_certification"
   ],
   "req": "Qualified welders and WPS/PQR to {v}",
   "kind": "scored"
  },
  {
   "id": "painting",
   "label": "Surface protection",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "Epoxy primer + PU finish",
    "Hot-dip galvanising",
    "Primer only",
    "None"
   ],
   "default": "Epoxy primer + PU finish",
   "question": "Painting / surface protection?",
   "data_point_ids": [
    "inhouse_vs_outsourced"
   ],
   "req": "Surface protection ({v}) in-house or controlled sub-tier",
   "kind": "scored"
  },
  {
   "id": "inspection",
   "label": "Inspection",
   "bucket": "technical",
   "type": "multi",
   "options": [
    "Visual + dimensional",
    "DPT",
    "UT of butt welds",
    "Third-party inspection"
   ],
   "default": [
    "Visual + dimensional",
    "DPT"
   ],
   "question": "Inspection requirements?",
   "data_point_ids": [
    "testing_equipment"
   ],
   "req": "Weld inspection capability ({v})",
   "kind": "scored"
  },
  {
   "id": "sector",
   "label": "Sector experience",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "Electrical & power",
    "Railways",
    "Infrastructure",
