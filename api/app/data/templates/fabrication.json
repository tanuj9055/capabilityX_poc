    "hsn_products"
   ],
   "req": "Fabrication experience in {v}",
   "kind": "scored"
  },
  {
   "id": "weight_t",
   "label": "Weight per unit",
   "bucket": "technical",
   "type": "number",
   "ask": true,
   "question": "Approximate weight per unit (tonnes)?",
