  },
  {
   "id": "material",
   "label": "Material",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "MS IS 2062 E250",
    "MS IS 2062 E350",
    "SS 304",
    "Aluminium"
   ],
   "ask": true,
   "question": "Material?",
