    "inhouse_vs_outsourced"
   ],
   "req": "Controlled coating route ({v})",
   "kind": "scored"
  },
  {
   "id": "manufacturing",
   "label": "Manufacturing route",
   "bucket": "technical",
   "type": "multi",
   "options": [
    "Cold forging / heading",
