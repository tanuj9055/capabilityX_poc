  {
   "id": "standard",
   "label": "Standard",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "IS 1364 / IS 1367",
    "DIN 933 / 931",
    "ISO 4014 / 4017",
    "ASME B18"
   ],
   "ask": true,
   "question": "Which standard?"
  },
  {
   "id": "property_class",
   "label": "Property class / grade",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "4.6",
    "8.8",
    "10.9",
    "12.9",
    "SS A2-70"
   ],
   "ask": true,
   "question": "Property class / grade?",
   "data_point_ids": [
    "testing_equipment"
   ],
   "req": "In-house mechanical testing (hardness, proof load) for property class {v}",
   "kind": "scored"
  },
  {
   "id": "coating",
   "label": "Coating",
   "bucket": "technical",
   "type": "choice",
   "options": [
    "Zinc plated",
    "Hot-dip galvanised",
    "Geomet / zinc flake",
    "Black oxide",
    "Plain"
