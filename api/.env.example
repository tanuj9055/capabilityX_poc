# Copy this file to api/.env and fill in the path to the GCP service-account key.
# The key file is NOT in the repo: get it privately from the project owner (never commit it).
# A relative path is resolved from the folder you start the backend in (api/).
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json
GCP_PROJECT=qistonpe-project-22810
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
